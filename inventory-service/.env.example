# inventory-service - copiar a .env y ajustar (el .env real NO se versiona)
SERVICE_NAME=inventory-service
NODE_ENV=development

# HTTP: puerto interno (en Docker Compose se usa 3000)
PORT=3002

# HTTPS: acceso externo con certificado autofirmado (ver scripts/gen-certs)
HTTPS_ENABLED=true
HTTPS_PORT=4002
SSL_KEY_PATH=../certs/server.key
SSL_CERT_PATH=../certs/server.crt

# MongoDB propio del servicio (en Docker: mongodb://inventory-db:27017/inventory_db)
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=10

# Redis para el lock distribuido (en Docker: redis://redis:6379)
REDIS_URL=redis://127.0.0.1:6379

# Exclusión mutua (TP2)
# LOCK_ENABLED=false SOLO para mostrar la condición de carrera (scripts/race-demo.js)
LOCK_ENABLED=true
# TTL del lock: mucho mayor que la sección crítica (decenas de ms), pero corto
# para que, si el proceso se cae con el lock tomado, el producto se libere solo.
LOCK_TTL_MS=5000
# Espera máxima para conseguir el lock; si se supera responde 503 + Retry-After
LOCK_WAIT_MS=3000
LOCK_RETRY_MS=50
# Retardo artificial dentro de la sección crítica (0 = desactivado)
DEMO_DELAY_MS=0

# Otros servicios (en Docker: http://catalog-service:3000)
CATALOG_SERVICE_URL=http://localhost:3001
HTTP_CLIENT_TIMEOUT_MS=5000

# JWT (TP7): secreto compartido por todos los servicios, mínimo 32 caracteres
JWT_SECRET=

# Logging (Winston). Rotación por fecha y por tamaño, con retención limitada.
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
