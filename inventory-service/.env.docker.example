# inventory-service en Docker - copiar a .env.docker y ajustar (el .env.docker real NO se versiona)
# Las URLs usan el NOMBRE DEL SERVICIO de docker-compose, nunca localhost.
SERVICE_NAME=inventory-service
NODE_ENV=production

# HTTP interno en la red de Docker (todos los servicios usan 3000)
PORT=3000

# HTTPS: puerto interno 3443, publicado en el host por docker-compose
HTTPS_ENABLED=true
HTTPS_PORT=3443
SSL_KEY_PATH=/certs/server.key
SSL_CERT_PATH=/certs/server.crt

# MongoDB propio del servicio
MONGODB_URI=mongodb://inventory-1-db:27017/inventory_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=20
# (docker-compose pisa SERVICE_NAME y MONGODB_URI en cada nodo: inventory-1, -2, -3)

# Redis compartido por los 3 nodos: el lock es distribuido entre todos
REDIS_URL=redis://redis:6379
LOCK_ENABLED=true
LOCK_TTL_MS=5000
LOCK_WAIT_MS=3000
LOCK_RETRY_MS=50
DEMO_DELAY_MS=0

# Otros servicios
CATALOG_SERVICE_URL=http://catalog-service:3000
# Solo para el seed: pide el token ADMIN a auth-service (mismo ADMIN que el seed de auth)
AUTH_SERVICE_URL=http://auth-service:3000
SEED_ADMIN_EMAIL=admin@voltix.com
SEED_ADMIN_PASSWORD=cambiar-password-admin
HTTP_CLIENT_TIMEOUT_MS=5000

# JWT: el MISMO secreto en los 4 servicios, mínimo 32 caracteres
JWT_SECRET=CAMBIAR-por-el-secreto-compartido-del-grupo
JWT_ISSUER=voltix-auth-service

# Logging (Winston): consola (docker compose logs) + archivos rotativos en /app/logs
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
# Raft (TP4): cluster de 3 nodos. Los ids tienen que coincidir con NODE_ID de docker-compose.
RAFT_ENABLED=true
# URLs INTERNAS (red de Docker, HTTP): las usan los nodos entre sí y orders-service
RAFT_PEERS=inventory-1=http://inventory-1:3000,inventory-2=http://inventory-2:3000,inventory-3=http://inventory-3:3000
# URLs PÚBLICAS (HTTPS publicado en el host): a donde redirige un follower (307) a quien llegó por HTTPS
RAFT_PUBLIC_URLS=inventory-1=https://localhost:4002,inventory-2=https://localhost:4012,inventory-3=https://localhost:4022
# Secreto compartido por los 3 nodos para RPC internos; distinto de JWT_SECRET y mínimo 16 caracteres
RAFT_TOKEN=CAMBIAR-por-un-token-largo-del-cluster
RAFT_HEARTBEAT_MS=300
RAFT_ELECTION_MIN_MS=1200
RAFT_ELECTION_MAX_MS=2400
RAFT_RPC_TIMEOUT_MS=800
RAFT_PROPOSE_TIMEOUT_MS=3000