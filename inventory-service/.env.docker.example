# inventory-service en Docker - copiar a .env.docker y ajustar (el .env.docker real NO se versiona)
# Las URLs usan el NOMBRE DEL SERVICIO de docker-compose, nunca localhost.
SERVICE_NAME=inventory-service
NODE_ENV=production

# HTTP interno en la red de Docker (todos los servicios usan 3000)
PORT=3000

# HTTPS: puerto interno 3443, publicado en el host por docker-compose
HTTPS_ENABLED=true
HTTPS_PORT=3443
SSL_KEY_PATH=/certs/server.key
SSL_CERT_PATH=/certs/server.crt

# MongoDB propio del servicio
MONGODB_URI=mongodb://inventory-1-db:27017/inventory_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=20
# (docker-compose pisa SERVICE_NAME y MONGODB_URI en cada nodo: inventory-1, -2, -3)

# Redis compartido por los 3 nodos: el lock es distribuido entre todos
REDIS_URL=redis://redis:6379
LOCK_ENABLED=true
LOCK_TTL_MS=5000
LOCK_WAIT_MS=3000
LOCK_RETRY_MS=50
DEMO_DELAY_MS=0

# Otros servicios
CATALOG_SERVICE_URL=http://catalog-service:3000
HTTP_CLIENT_TIMEOUT_MS=5000

# JWT: el MISMO secreto en los 4 servicios, mínimo 32 caracteres
JWT_SECRET=CAMBIAR-por-el-secreto-compartido-del-grupo
JWT_ISSUER=voltix-auth-service

# Logging (Winston): consola (docker compose logs) + archivos rotativos en /app/logs
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
