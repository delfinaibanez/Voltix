# auth-service - copiar a .env y ajustar (el .env real NO se versiona)
SERVICE_NAME=auth-service
NODE_ENV=development

# HTTP: puerto interno (en Docker Compose se usa 3000)
PORT=3004

# HTTPS: acceso externo con certificado autofirmado (ver scripts/gen-certs.ps1)
HTTPS_ENABLED=true
HTTPS_PORT=4004
SSL_KEY_PATH=../certs/server.key
SSL_CERT_PATH=../certs/server.crt

# MongoDB propio del servicio (en Docker: mongodb://auth-db:27017/auth_db)
MONGODB_URI=mongodb://127.0.0.1:27017/auth_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=10

# JWT: el secreto DEBE ser el mismo en todos los servicios y tener 32+ caracteres.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=1h
JWT_ISSUER=voltix-auth-service

# Costo del hash bcrypt (12 es un buen valor; subirlo hace el login más lento)
BCRYPT_ROUNDS=12

# Usuarios de prueba para npm run seed (cambiar las contraseñas en el .env real)
SEED_ADMIN_EMAIL=admin@voltix.com
SEED_ADMIN_PASSWORD=CAMBIAR_Admin_1234
SEED_USER_EMAIL=usuario@voltix.com
SEED_USER_PASSWORD=CAMBIAR_Usuario_1234

# Logging (Winston). Rotación por fecha y por tamaño, con retención limitada.
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d