# auth-service en Docker - copiar a .env.docker y ajustar (el .env.docker real NO se versiona)
# Las URLs usan el NOMBRE DEL SERVICIO de docker-compose, nunca localhost.
SERVICE_NAME=auth-service
NODE_ENV=production

# HTTP interno en la red de Docker (todos los servicios usan 3000)
PORT=3000

# HTTPS: puerto interno 3443, publicado en el host por docker-compose
HTTPS_ENABLED=true
HTTPS_PORT=3443
SSL_KEY_PATH=/certs/server.key
SSL_CERT_PATH=/certs/server.crt

# MongoDB propio del servicio
MONGODB_URI=mongodb://auth-db:27017/auth_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=20

# JWT: el MISMO secreto en los 4 servicios, mínimo 32 caracteres
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
JWT_ISSUER=voltix-auth-service

# Costo del hash bcrypt (12 es un buen valor; subirlo hace el login más lento)
BCRYPT_ROUNDS=12

# Usuarios de prueba para el seed (cambiar las contraseñas en el .env.docker real)
SEED_ADMIN_EMAIL=admin@voltix.com
SEED_ADMIN_PASSWORD=cambiar-password-admin
SEED_USER_EMAIL=usuario@voltix.com
SEED_USER_PASSWORD=cambiar-password-usuario

# Logging (Winston): consola (docker compose logs) + archivos rotativos en /app/logs
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d