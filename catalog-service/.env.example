# catalog-service - copiar a .env y ajustar (el .env real NO se versiona)
SERVICE_NAME=catalog-service
NODE_ENV=development

# HTTP: puerto interno (en Docker Compose se usa 3000)
PORT=3001

# HTTPS: acceso externo con certificado autofirmado (ver scripts/gen-certs)
HTTPS_ENABLED=true
HTTPS_PORT=4001
SSL_KEY_PATH=../certs/server.key
SSL_CERT_PATH=../certs/server.crt

# MongoDB propio del servicio (en Docker: mongodb://catalog-db:27017/catalog_db)
MONGODB_URI=mongodb://127.0.0.1:27017/catalog_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=10

# Logging (Winston). Rotación por fecha y por tamaño, con retención limitada.
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d