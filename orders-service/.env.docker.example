# orders-service en Docker - copiar a .env.docker y ajustar (el .env.docker real NO se versiona)
# Las URLs usan el NOMBRE DEL SERVICIO de docker-compose, nunca localhost.
SERVICE_NAME=orders-service
NODE_ENV=production

# HTTP interno en la red de Docker (todos los servicios usan 3000)
PORT=3000

# HTTPS: puerto interno 3443, publicado en el host por docker-compose
HTTPS_ENABLED=true
HTTPS_PORT=3443
SSL_KEY_PATH=/certs/server.key
SSL_CERT_PATH=/certs/server.crt

# MongoDB propio del servicio
MONGODB_URI=mongodb://orders-db:27017/orders_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=20

# Otros servicios. INVENTORY_SERVICE_URL admite una lista separada por comas (3 nodos).
CATALOG_SERVICE_URL=http://catalog-service:3000
INVENTORY_SERVICE_URL=http://inventory-1:3000,http://inventory-2:3000,http://inventory-3:3000
AUTH_SERVICE_URL=http://auth-service:3000

# JWT: el MISMO secreto en los 4 servicios, mínimo 32 caracteres
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR-por-el-secreto-compartido-del-grupo
JWT_ISSUER=voltix-auth-service

# Logging (Winston): consola (docker compose logs) + archivos rotativos en /app/logs
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
