# orders-service - copiar a .env y ajustar (el .env real NO se versiona)
SERVICE_NAME=orders-service
NODE_ENV=development

# HTTP: puerto interno (en Docker Compose se usa 3000)
PORT=3003

# HTTPS: acceso externo con certificado autofirmado (ver scripts/gen-certs)
HTTPS_ENABLED=true
HTTPS_PORT=4003
SSL_KEY_PATH=../certs/server.key
SSL_CERT_PATH=../certs/server.crt

# MongoDB propio del servicio (en Docker: mongodb://orders-db:27017/orders_db)
MONGODB_URI=mongodb://127.0.0.1:27017/orders_db
MONGO_RETRY_MS=3000
MONGO_MAX_RETRIES=10

# Otros servicios (en Docker: http://catalog-service:3000 e http://inventory-service:3000)
CATALOG_SERVICE_URL=http://localhost:3001
# Admite una lista separada por comas (nodos del cluster Raft): se prueban en orden
# y se sigue el 307 del nodo que no es líder. Ej: http://localhost:3002,http://localhost:3012,http://localhost:3022
INVENTORY_SERVICE_URL=http://localhost:3002
# Timeout de cada llamada HTTP a otro servicio (ms)
REQUEST_TIMEOUT_MS=3000

# JWT (TP7): HS256, secreto compartido por todos los servicios, mínimo 32 caracteres
JWT_SECRET=

# Logging (Winston). Rotación por fecha y por tamaño, con retención limitada.
LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
